{
  "name": "volcre",
  "version": "1.0.0",
  "main": "src/main.tsx",
  "scripts": {
    "setup:env": "node ./scripts/ensure-env.js",
    "download:fonts": "node ./scripts/download-fonts.js",
    "postinstall": "node ./scripts/ensure-env.js && node ./scripts/download-fonts.js",
    "prestart": "node ./scripts/ensure-env.js",
    "preandroid": "node ./scripts/ensure-env.js",
    "preios": "node ./scripts/ensure-env.js",
    "preweb": "node ./scripts/ensure-env.js",
    "prebackend": "node ./scripts/ensure-env.js",
    "prebackend:seed-storage": "node ./scripts/ensure-env.js",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
    "restart": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& './scripts/stop-all.ps1'; & './scripts/start-all.ps1'\"",
    "info": "node ./scripts/show-startup-info.js",
    "qa:smoke": "node ./scripts/qa-smoke-e2e.js",
    "all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-all.ps1",
    "all:bg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/supervise-dev.ps1",
    "all:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-all.ps1",
    "all:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/status-all.ps1",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pod:install": "cd ios && pod install && cd ..",
    "web": "vite --host 0.0.0.0 --port 8081",
    "backend": "node ./scripts/run-python.js -m uvicorn backend.api:app --host 0.0.0.0 --port 8000 --ws websockets --reload --reload-dir backend",
    "backend:stable": "node ./scripts/run-python.js -m uvicorn backend.api:app --host 0.0.0.0 --port 8000 --ws websockets",
    "backend:seed-storage": "node ./scripts/run-python.js -m backend.app_storage_seed",
    "db:cleanup": "node ./scripts/run-python.js -m backend.database_cleanup",
    "db:cleanup:aggressive": "node ./scripts/run-python.js -m backend.heavy_cleanup",
    "db:cleanup:session": "node ./scripts/run-python.js -m backend.session_cleanup",
    "db:cleanup:batch": "node ./scripts/run-python.js -m backend.batch_cleanup",
    "db:maintenance": "node ./scripts/run-python.js -m backend.database_manager",
    "db:maintenance:report": "node ./scripts/run-python.js -m backend.database_manager --report",
    "db:init": "node ./scripts/run-python.js -m backend.init_supabase",
    "db:migrate": "node ./scripts/run-python.js -m backend.migrate_database",
    "db:migrate:direct": "node ./scripts/run-python.js -m backend.migrate_database_direct",
    "db:monitor": "node ./scripts/run-python.js -m backend.db_monitor",
    "db:monitor:auto": "node ./scripts/run-python.js -m backend.db_monitor --auto",
    "db:monitor:report": "node ./scripts/run-python.js -m backend.db_monitor",
    "deploy:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-deployment-bundle.ps1",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:watch": "playwright test --project=chromium-headed",
    "test:e2e:watch:admin": "playwright test tests/e2e/workflows/admin.spec.ts --project=chromium-headed",
    "test:e2e:watch:volunteer": "playwright test tests/e2e/workflows/volunteer.spec.ts --project=chromium-headed",
    "test:e2e:watch:partner": "playwright test tests/e2e/workflows/partner.spec.ts --project=chromium-headed",
    "test:e2e:watch:cross": "playwright test tests/e2e/workflows/cross-role.spec.ts --project=chromium-headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:volunteer": "playwright test tests/e2e/workflows/volunteer.spec.ts",
    "test:e2e:admin": "playwright test tests/e2e/workflows/admin.spec.ts",
    "test:e2e:partner": "playwright test tests/e2e/workflows/partner.spec.ts",
    "test:e2e:cross": "playwright test tests/e2e/workflows/cross-role.spec.ts",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@supabase/supabase-js": "^2.105.1",
    "date-fns": "^3.0.0",
    "expo-auth-session": "^57.0.9",
    "expo-document-picker": "^57.0.1",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "^57.0.7",
    "expo-web-browser": "^57.0.2",
    "firebase": "^12.17.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-document-picker": "^9.0.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.13.0",
    "react-native-image-picker": "^7.0.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "^3.5.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^8.1.0",
    "react-native-svg": "^14.1.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@playwright/test": "^1.60.0",
    "@react-native/babel-preset": "^0.73.0",
    "@react-native/eslint-config": "^0.73.0",
    "@react-native/metro-config": "^0.73.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "playwright": "^1.60.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.19"
  },
  "private": true
}
